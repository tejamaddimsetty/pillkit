# Copy to .env (never commit .env).
# Local development uses SQLite. For Hostinger MySQL:
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL=sqlite:///storage/pillkit.db
# Long random string; signs portal sessions.
SECRET_KEY=change-me
# Ed25519 key that signs licences and feeds. Generated on first run if missing.
# Keep it out of the repo and back it up: losing it invalidates every host.
SIGNING_KEY_PATH=storage/signing.key
PUBLIC_BASE_URL=http://127.0.0.1:5050
PORT=5050
# How often hosts re-check for new items. 300 in production; 15 while testing.
FEED_POLL_SECS=300
