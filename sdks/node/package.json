{
  "name": "pillkit",
  "version": "0.3.0",
  "description": "Show your desktop app's notifications as a small pill widget in the macOS menu bar and the Windows taskbar. Free, local only, works with Electron and Node.js.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cli.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "pillkit-host-darwin-arm64": "0.3.0",
    "pillkit-host-darwin-x64": "0.3.0",
    "pillkit-host-win32-x64": "0.3.0",
    "pillkit-host-linux-x64": "0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejamaddimsetty/pillkit.git",
    "directory": "sdks/node"
  },
  "homepage": "https://github.com/tejamaddimsetty/pillkit#readme",
  "keywords": [
    "menubar",
    "menu-bar",
    "macos-menu-bar",
    "tray",
    "system-tray",
    "taskbar",
    "windows-taskbar",
    "status-bar",
    "notification",
    "notifications",
    "widget",
    "desktop",
    "electron",
    "electron-tray",
    "nodejs",
    "macos",
    "windows",
    "cross-platform",
    "pill",
    "pillkit"
  ],
  "bin": {
    "pillkit": "cli.js"
  },
  "author": "Tej Maddimsetty",
  "bugs": {
    "url": "https://github.com/tejamaddimsetty/pillkit/issues"
  }
}
